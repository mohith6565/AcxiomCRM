@model Customer
<h2>@Model.CustomerName</h2><div class="card p-4 border-0 shadow-sm"><dl class="row">
<dt class="col-sm-3">Customer Code</dt><dd class="col-sm-9">@Model.CustomerCode</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
<dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd><dt class="col-sm-3">Company</dt><dd class="col-sm-9">@Model.Company</dd>
<dt class="col-sm-3">Address</dt><dd class="col-sm-9">@Model.Address</dd><dt class="col-sm-3">City / State</dt><dd class="col-sm-9">@Model.City / @Model.State</dd>
<dt class="col-sm-3">Status</dt><dd class="col-sm-9">@Model.Status</dd><dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Model.CreatedAtUtc.ToLocalTime()</dd>
</dl><div><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-gold">Edit</a> <a asp-action="Index" class="btn btn-outline-secondary">Back</a></div></div>
