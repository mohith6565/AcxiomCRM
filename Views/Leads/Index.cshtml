@model IEnumerable<Lead>
<div class="d-flex justify-content-between mb-3"><h2>Leads</h2><a asp-action="Create" class="btn btn-gold">+ New Lead</a></div>
<form method="get" class="mb-3 d-flex gap-2"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search leads" style="max-width:400px"/><button class="btn btn-outline-secondary">Search</button></form>
<div class="card border-0 shadow-sm table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Source</th><th>Status</th><th>Priority</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Name</td><td>@x.Email</td><td>@x.Phone</td><td>@x.Source</td><td>@x.Status</td><td>@x.Priority</td><td><a asp-action="Edit" asp-route-id="@x.Id">Edit</a></td></tr>}</tbody></table></div>
