@model Opportunity
<h2>New Opportunity</h2><form asp-action="Create" method="post" class="card border-0 shadow-sm p-4"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
<div class="col-md-6"><label asp-for="OpportunityName" class="form-label"></label><input asp-for="OpportunityName" class="form-control"/><span asp-validation-for="OpportunityName" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="CustomerId" class="form-label">Customer</label><select asp-for="CustomerId" class="form-select"><option value="">-- Select customer --</option>@foreach(Customer c in ViewBag.Customers){<option value="@c.Id">@c.CustomerName</option>}</select></div>
<div class="col-md-6"><label asp-for="Amount" class="form-label"></label><input asp-for="Amount" class="form-control"/><span asp-validation-for="Amount" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Probability" class="form-label"></label><input asp-for="Probability" class="form-control"/><span asp-validation-for="Probability" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Stage" class="form-label"></label><select asp-for="Stage" class="form-select"><option>Qualification</option><option>Proposal</option><option>Negotiation</option><option>Won</option><option>Lost</option></select></div>
<div class="col-md-6"><label asp-for="ExpectedCloseDate" class="form-label"></label><input asp-for="ExpectedCloseDate" type="date" class="form-control"/><span asp-validation-for="ExpectedCloseDate" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control"></textarea></div>
</div><div class="mt-4"><button class="btn btn-gold">Save Opportunity</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form>
@section Scripts {<partial name="_ValidationScriptsPartial" />}
