<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>AcxiomCRM</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark crm-nav"><div class="container-fluid">
<a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">ACXIOM<span>CRM</span></a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="nav">
<ul class="navbar-nav me-auto">
@if(User.Identity?.IsAuthenticated ?? false){
<li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Customers</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Leads" asp-action="Index">Leads</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Opportunities" asp-action="Index">Opportunities</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="FollowUps" asp-action="Index">Follow-ups</a></li>
}
</ul>
<partial name="_LoginPartial" />
</div></div></nav>
<main class="container py-4">@RenderBody()</main>
<footer class="container py-4 text-muted small">AcxiomCRM · Customer and Sales Management</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
